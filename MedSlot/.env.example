# =============================================================================
# MedSlot — Environment Variables Template
# Copy this file to .env.local and fill in all values before running.
# NEVER commit .env.local or any file containing real secrets.
# Full environment configuration is defined in TASK-003.
# =============================================================================

# --- Django Core ---
# Generate a unique SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Django settings module (local dev default)
DJANGO_SETTINGS_MODULE=medslot.settings.local

# --- Database ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://medslot:medslot@localhost:5432/medslot

# --- Redis / Cache / Celery Broker ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET=

# --- MSG91 (SMS OTP) ---
MSG91_API_KEY=
MSG91_TEMPLATE_ID=

# --- SendGrid (Email) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@medslot.in
SENDGRID_FROM_NAME=MedSlot

# --- AWS ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- S3 Buckets ---
S3_RECORDS_BUCKET=medslot-records
S3_PRESCRIPTIONS_BUCKET=medslot-prescriptions
S3_CREDENTIALS_BUCKET=medslot-credentials

# --- Razorpay (Doctor Subscription Billing) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- OTP Security ---
# Pepper value used for SHA-256 + PEPPER OTP hashing (keep this secret)
OTP_PEPPER=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Django Debug / Hosts (local dev) ---
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
