# =============================================================================
# MedSlot — Root .gitignore
# Covers: Node.js/Next.js, Python/Django, AWS CDK, Docker, IDE artifacts
# =============================================================================

# ---------------------------------------------------------------------------
# Node.js / Next.js (frontend/ and infra/)
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# Next.js build output
frontend/.next/
frontend/out/
frontend/build/

# Next.js cache
frontend/.swc/

# Vercel
.vercel

# ---------------------------------------------------------------------------
# Python / Django (backend/)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Django artifacts
backend/db.sqlite3
backend/db.sqlite3-journal
backend/*.log
backend/staticfiles/
backend/mediafiles/
backend/.env

# pytest / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ---------------------------------------------------------------------------
# AWS CDK (infra/)
# ---------------------------------------------------------------------------
infra/cdk.out/
infra/*.js
infra/*.d.ts
!infra/jest.config.js
infra/tsconfig.tsbuildinfo

# CDK asset staging
cdk.staging/

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Docker override files (local-only compose overrides)
docker-compose.override.yml

# ---------------------------------------------------------------------------
# Secrets & credentials — NEVER commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account.json

# ---------------------------------------------------------------------------
# IDE / Editor
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# OS artifacts
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/
