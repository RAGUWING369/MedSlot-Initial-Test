# =============================================================================
# MedSlot — Local Development Environment Template
# -----------------------------------------------------------------------------
# Copy this file to .env.local before running Docker Compose:
#   cp .env.local.example .env.local
#
# Then fill in your actual secret values in .env.local.
# NEVER commit .env.local to version control.
# =============================================================================

# ── Django Core ───────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=medslot.settings.local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://medslot:medslot_dev@db:5432/medslot

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here

# ── MSG91 (SMS OTP) ───────────────────────────────────────────────────────────
MSG91_API_KEY=your-msg91-api-key
MSG91_TEMPLATE_ID=your-msg91-template-id

# ── SendGrid (Email) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@medslot.in
SENDGRID_FROM_NAME=MedSlot

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ── S3 Buckets ────────────────────────────────────────────────────────────────
S3_RECORDS_BUCKET=medslot-records-dev
S3_PRESCRIPTIONS_BUCKET=medslot-prescriptions-dev
S3_CREDENTIALS_BUCKET=medslot-credentials-dev

# ── Razorpay (Doctor Subscription Billing) ────────────────────────────────────
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── OTP Security ──────────────────────────────────────────────────────────────
OTP_PEPPER=your-otp-pepper-secret

# ── Next.js / Frontend ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
