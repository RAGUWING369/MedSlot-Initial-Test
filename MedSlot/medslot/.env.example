# =============================================================================
# MedSlot — Environment Variables Template
# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT SETUP:
#   cp .env.example .env.local
#   Fill in all values in .env.local, then run: docker-compose up --build
#
# NEVER commit .env.local or any file containing real secrets.
# All secrets are loaded at runtime via env_file in docker-compose.yml.
# =============================================================================

# ── Django Core ───────────────────────────────────────────────────────────────
# Generate a unique value: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# Use medslot.settings.local inside Docker; medslot.settings.production in ECS.
DJANGO_SETTINGS_MODULE=medslot.settings.local

DEBUG=True

# ALLOWED_HOSTS — comma-separated list of allowed host/domain names.
# Local dev: localhost,127.0.0.1
# Production: set to your public domain(s), e.g. api.medslot.in,medslot.in
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# Inside Docker Compose the hostname is the service name "db".
# For local non-Docker development change POSTGRES_HOST to "localhost".
DATABASE_URL=postgresql://medslot:medslot_dev@db:5432/medslot

# Individual Postgres vars — consumed by Django settings (local.py / production.py).
POSTGRES_DB=medslot
POSTGRES_USER=medslot
POSTGRES_PASSWORD=medslot_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis / Cache / Celery Broker ─────────────────────────────────────────────
# Inside Docker Compose the hostname is the service name "redis".
# For local non-Docker development change "redis" to "localhost".
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here

# ── MSG91 (SMS OTP) ───────────────────────────────────────────────────────────
MSG91_API_KEY=your-msg91-api-key
MSG91_TEMPLATE_ID=your-msg91-template-id

# ── SendGrid (Email) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@medslot.in
SENDGRID_FROM_NAME=MedSlot

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ── S3 Buckets ────────────────────────────────────────────────────────────────
S3_RECORDS_BUCKET=medslot-records-dev
S3_PRESCRIPTIONS_BUCKET=medslot-prescriptions-dev
S3_CREDENTIALS_BUCKET=medslot-credentials-dev

# ── Razorpay (Doctor Subscription Billing) ────────────────────────────────────
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── OTP Security ──────────────────────────────────────────────────────────────
# Pepper value used for SHA-256+PEPPER OTP hashing (keep this secret and stable).
OTP_PEPPER=your-otp-pepper-secret

# ── Next.js / Frontend ────────────────────────────────────────────────────────
# Public env var consumed by the Next.js frontend (NEXT_PUBLIC_ prefix required).
# Points to the Django API. Inside Docker Compose the API is at http://api:8000
# from container-to-container, but the browser uses http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
